# article-local public configuration template
#
# Copy this file only for local experiments. Do not rename it to .env and commit
# it with personal values. 不要填写真实 API key，不要填写论文路径，
# 不要提交本地日志、运行缓存或修复稿路径。

# Optional: enable the local web page's manual GitHub Release version check.
# Replace <owner>/<repo> only in your local private environment.
ARTICLE_LOCAL_RELEASE_API_URL=https://api.github.com/repos/<owner>/<repo>/releases/latest
# For Beta or prerelease packages, prefer the release tag endpoint:
# ARTICLE_LOCAL_RELEASE_API_URL=https://api.github.com/repos/<owner>/<repo>/releases/tags/<release-tag>

# Do not add API keys, thesis paths, repaired document paths, logs, runtime
# directories, or feedback archive paths to committed configuration files.
