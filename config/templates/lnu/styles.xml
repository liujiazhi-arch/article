<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  辽宁大学本科毕业论文 styles.xml
  依据：辽宁大学官方论文格式样本（lnu-undergraduate-format-template.doc）
        + lnu-undergraduate.yaml Profile
  生成日期：2026-03-26
  用途：由 inject_template_components() 注入，替换用户文档的 Word 样式库，
        确保"新输入段落"和"清除格式后"都能继承正确的辽大基准样式。

  核心样式：
    Normal（正文）   — 宋体/TNR 12pt，1.5倍行距，首行2字，两端对齐
    Heading 1        — 黑体 16pt，居中，不加粗
    Heading 2        — 黑体 14pt，左对齐，不加粗
    Heading 3        — 黑体 12pt，左对齐，不加粗
    Heading 4        — 宋体 12pt，左对齐，不加粗，缩进2字符
    Caption          — 宋体 10.5pt，居中
    Bibliography     — 宋体 10.5pt，悬挂缩进，1.5倍行距
    Abstract CN      — 正文继承，用于中文摘要
    Abstract EN Body — TNR 12pt，用于英文摘要正文
    Acknowledgement  — 仿宋 12pt

  DXA 换算：1pt = 20 twips；1cm ≈ 567 twips
  half-points：1pt = 2 half-points（w:sz 单位）
-->
<w:styles
  xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
  xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="w14">

  <!-- ═══════════════════════════════════════
       文档默认格式（docDefaults）
       ═══════════════════════════════════════ -->
  <w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <!-- 西文默认：Times New Roman 12pt -->
        <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:eastAsia="宋体" w:cs="Times New Roman"/>
        <w:sz w:val="24"/>
        <w:szCs w:val="24"/>
        <w:lang w:val="en-US" w:eastAsia="zh-CN"/>
      </w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <!-- 默认行距：1.5倍行距（240×1.5=360 twips）-->
        <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
        <w:jc w:val="both"/>
        <!-- 关闭自动间距 -->
        <w:autoSpaceDE w:val="0"/>
        <w:autoSpaceDN w:val="0"/>
        <!-- 关闭网格对齐（辽大要求明确"取消网格对齐"）-->
        <w:snapToGrid w:val="0"/>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>

  <!-- ═══════════════════════════════════════
       latentStyles（仅保留必要的，抑制 Word 自动补全样式）
       ═══════════════════════════════════════ -->
  <w:latentStyles w:defLockedState="0" w:defUIPriority="99"
                  w:defSemiHidden="0" w:defUnhideWhenUsed="0"
                  w:defQFormat="0" w:count="376"/>

  <!-- ═══════════════════════════════════════
       Normal（正文 / 默认段落）
       宋体/TNR 12pt，两端对齐，1.5倍行距，首行缩进2字（480 twips）
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:default="1" w:styleId="Normal">
    <w:name w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:jc w:val="both"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="480"/>
      <w:autoSpaceDE w:val="0"/>
      <w:autoSpaceDN w:val="0"/>
      <w:snapToGrid w:val="0"/>
      <w:contextualSpacing w:val="0"/>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       默认段落字体（Default Paragraph Font）
       ═══════════════════════════════════════ -->
  <w:style w:type="character" w:default="1" w:styleId="DefaultParagraphFont">
    <w:name w:val="Default Paragraph Font"/>
    <w:uiPriority w:val="1"/>
    <w:semiHidden/>
    <w:unhideWhenUsed/>
  </w:style>

  <!-- ═══════════════════════════════════════
       Heading 1（标题 1）
       黑体 16pt（三号），居中，不加粗，段前后0.5行，独立页
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Heading1">
    <w:name w:val="heading 1"/>
    <w:aliases w:val="标题 1,标题1"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:pageBreakBefore/>
      <w:outlineLvl w:val="0"/>
      <w:jc w:val="center"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="120" w:after="120"/>
      <!-- 一级标题不做首行缩进 -->
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 黑体 16pt = 32 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="黑体" w:cs="Times New Roman"/>
      <w:sz w:val="32"/>
      <w:szCs w:val="32"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Heading 2（标题 2）
       黑体 14pt（四号），左对齐，不加粗，段前后0.5行
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Heading2">
    <w:name w:val="heading 2"/>
    <w:aliases w:val="标题 2,标题2"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:outlineLvl w:val="1"/>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="120" w:after="120"/>
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 黑体 14pt = 28 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="黑体" w:cs="Times New Roman"/>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Heading 3（标题 3）
       黑体 12pt（小四），左对齐，不加粗，段前后0.5行
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Heading3">
    <w:name w:val="heading 3"/>
    <w:aliases w:val="标题 3,标题3"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:outlineLvl w:val="2"/>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="120" w:after="120"/>
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 黑体 12pt = 24 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="黑体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Heading 4（标题 4）
       宋体 12pt（小四），左对齐，不加粗，缩进2字符，段前后0.5行
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Heading4">
    <w:name w:val="heading 4"/>
    <w:aliases w:val="标题 4,标题4"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:outlineLvl w:val="3"/>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="120" w:after="120"/>
      <w:ind w:firstLine="480"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Caption（题注 / 图表标题）
       宋体 10.5pt（五号 = 21 half-points），居中，无首行缩进
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Caption">
    <w:name w:val="caption"/>
    <w:aliases w:val="图注,表注,题注"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:jc w:val="center"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="60" w:after="60"/>
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 宋体 10.5pt = 21 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="21"/>
      <w:szCs w:val="21"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Bibliography（参考文献条目）
       宋体/TNR 10.5pt，悬挂缩进，1.5倍行距（360 twips）
       LNU：编号[N] 空格，悬挂缩进560 twips
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Bibliography">
    <w:name w:val="Bibliography"/>
    <w:aliases w:val="参考文献,书目"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Bibliography"/>
    <w:pPr>
      <w:jc w:val="both"/>
      <!-- 1.5倍行距 -->
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <!-- 悬挂缩进：左缩进560，首行 -560（悬挂） -->
      <w:ind w:left="560" w:hanging="560"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="21"/>
      <w:szCs w:val="21"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Acknowledgement（致谢正文）
       仿宋 12pt（小四），两端对齐，1.5倍行距，首行缩进
       辽大特有：致谢用仿宋体
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Acknowledgement">
    <w:name w:val="Acknowledgement"/>
    <w:aliases w:val="致谢,Acknowledgment"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Acknowledgement"/>
    <w:pPr>
      <w:jc w:val="both"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="480"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 仿宋 12pt = 24 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="仿宋" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Abstract（中文摘要正文）
       继承 Normal，无额外差异
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="AbstractCN">
    <w:name w:val="Abstract CN"/>
    <w:aliases w:val="摘要正文"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="AbstractCN"/>
  </w:style>

  <!-- ═══════════════════════════════════════
       Abstract EN Body（英文摘要正文）
       Times New Roman 12pt，两端对齐，单倍行距，首行缩进
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="AbstractENBody">
    <w:name w:val="Abstract EN Body"/>
    <w:aliases w:val="英文摘要正文"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="AbstractENBody"/>
    <w:pPr>
      <w:jc w:val="both"/>
      <w:spacing w:line="240" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="480"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 英文摘要：Times New Roman 12pt -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Abstract Heading（摘要标题）
       黑体 16pt（三号=32 half-points），居中，不加粗，段后0pt
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="AbstractHeading">
    <w:name w:val="Abstract Heading"/>
    <w:aliases w:val="摘要标题"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="AbstractCN"/>
    <w:pPr>
      <w:jc w:val="center"/>
      <!-- 段后0pt -->
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- 黑体 16pt（三号）= 32 half-points -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="黑体" w:cs="Times New Roman"/>
      <w:sz w:val="32"/>
      <w:szCs w:val="32"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Abstract EN Heading（英文摘要标题 "Abstract"）
       Times New Roman 16pt（三号=32 hp），居中，加粗
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="AbstractENHeading">
    <w:name w:val="Abstract EN Heading"/>
    <w:aliases w:val="英文摘要标题"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="AbstractENBody"/>
    <w:pPr>
      <w:jc w:val="center"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="220"/>
      <w:ind w:firstLine="0"/>
      <w:snapToGrid w:val="0"/>
    </w:pPr>
    <w:rPr>
      <!-- Times New Roman 16pt（三号）= 32 half-points，加粗 -->
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="黑体" w:cs="Times New Roman"/>
      <w:b/>
      <w:bCs/>
      <w:sz w:val="32"/>
      <w:szCs w:val="32"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Footer（页脚）
       宋体 10.5pt（五号），居中，无首行缩进
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Footer">
    <w:name w:val="footer"/>
    <w:aliases w:val="页脚"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:jc w:val="center"/>
      <w:spacing w:line="240" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="0"/>
      <w:tabs>
        <w:tab w:val="center" w:pos="4320"/>
        <w:tab w:val="right" w:pos="8640"/>
      </w:tabs>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="21"/>
      <w:szCs w:val="21"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Header（页眉）
       宋体 10.5pt，居中
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="Header">
    <w:name w:val="header"/>
    <w:aliases w:val="页眉"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:jc w:val="center"/>
      <w:spacing w:line="240" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="0"/>
      <w:tabs>
        <w:tab w:val="center" w:pos="4320"/>
        <w:tab w:val="right" w:pos="8640"/>
      </w:tabs>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="21"/>
      <w:szCs w:val="21"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Footnote Text（脚注文本）
       宋体 9pt（= 18 half-points，不低于16 half-points）
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="FootnoteText">
    <w:name w:val="footnote text"/>
    <w:aliases w:val="脚注文本"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:line="240" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="18"/>
      <w:szCs w:val="18"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       Footnote Reference（脚注引用，上标字符样式）
       ═══════════════════════════════════════ -->
  <w:style w:type="character" w:styleId="FootnoteReference">
    <w:name w:val="footnote reference"/>
    <w:aliases w:val="脚注引用"/>
    <w:basedOn w:val="DefaultParagraphFont"/>
    <w:rPr>
      <w:vertAlign w:val="superscript"/>
    </w:rPr>
  </w:style>

  <!-- ═══════════════════════════════════════
       TOC 1-3（目录条目）
       目录内容：宋体小四（12pt），左对齐，有前导符
       ═══════════════════════════════════════ -->
  <w:style w:type="paragraph" w:styleId="TOC1">
    <w:name w:val="toc 1"/>
    <w:aliases w:val="目录 1"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:pPr>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:firstLine="0"/>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="8400"/>
      </w:tabs>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <w:style w:type="paragraph" w:styleId="TOC2">
    <w:name w:val="toc 2"/>
    <w:aliases w:val="目录 2"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:pPr>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:left="240" w:firstLine="0"/>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="8400"/>
      </w:tabs>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <w:style w:type="paragraph" w:styleId="TOC3">
    <w:name w:val="toc 3"/>
    <w:aliases w:val="目录 3"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:pPr>
      <w:jc w:val="left"/>
      <w:spacing w:line="360" w:lineRule="auto" w:before="0" w:after="0"/>
      <w:ind w:left="480" w:firstLine="0"/>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="8400"/>
      </w:tabs>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"
                w:eastAsia="宋体" w:cs="Times New Roman"/>
      <w:sz w:val="24"/>
      <w:szCs w:val="24"/>
    </w:rPr>
  </w:style>

  <!-- TOC Heading（目录标题 "目录"二字）
       黑体16pt，居中，加粗 -->
  <w:style w:type="paragraph" w:styleId="TOCHeading">
    <w:name w:val="TOC Heading"/>
    <w:aliases w:val="目录标题"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
